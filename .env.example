# Database (Postgres native - service postgresql)
DATABASE_URL=postgres://dota:dota@localhost:5432/dota_tracker

# Steam Web API
STEAM_API_KEY=

# OpenDota (opsional, untuk limit lebih tinggi)
OPENDOTA_API_KEY=

# STRATZ
STRATZ_TOKEN=

# Server
PORT=3001
# Alamat bind API. 127.0.0.1 untuk lokal; container butuh 0.0.0.0
HOST=127.0.0.1

# Scheduler
SYNC_INTERVAL_CRON=*/30 * * * *
# debug | info | warn | error
LOG_LEVEL=info

# CORS: daftar origin dipisah koma. Kosongkan kalau FE memakai proxy Vite.
# CORS_ORIGIN=http://localhost:5173
# Batas permintaan per menit ke API kita sendiri
RATE_LIMIT_MAX=120

# Terapkan migrasi otomatis saat API start (dipakai container; default false)
# RUN_MIGRATIONS=true
