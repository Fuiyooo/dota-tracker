# Database (Postgres native - service postgresql)
DATABASE_URL=postgres://dota:dota@localhost:5432/dota_tracker

# Steam Web API
STEAM_API_KEY=

# OpenDota (opsional, untuk limit lebih tinggi)
OPENDOTA_API_KEY=

# STRATZ
STRATZ_TOKEN=

# Server
PORT=3001

# Scheduler
SYNC_INTERVAL_CRON=*/30 * * * *
# debug | info | warn | error
LOG_LEVEL=info

# CORS: daftar origin dipisah koma. Kosongkan kalau FE memakai proxy Vite.
# CORS_ORIGIN=http://localhost:5173
# Batas permintaan per menit ke API kita sendiri
RATE_LIMIT_MAX=120
